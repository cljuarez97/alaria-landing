---
// Barra inferior tipo app (<1024px). Persiste entre navegaciones: aria-current y la píldora
// se actualizan en el cliente tras cada `astro:after-swap`.
import Icon from './Icon.astro';
import type { IconName } from './icons/icons';
import { nav } from '../data/content';
import { ui } from '../data/ui';
import { href, isActive, routeOf } from '../lib/url';

const iconFor: Record<string, IconName> = {
  '/': 'house',
  '/tratamientos/': 'layers',
  '/resultados/': 'images',
  '/visitanos/': 'map-pin',
  '/agendar/': 'calendar-check',
};

const route = routeOf(Astro.url.pathname);
const activeIndex = nav.findIndex((item) => isActive(item.href, route));
const ctaHref = nav[nav.length - 1]!.href;
---
<nav
  aria-label={ui.bottomNav}
  class="bottom-nav fixed inset-x-0 bottom-0 z-40 lg:hidden"
  transition:persist="bottom-nav"
  data-bottom-nav
>
  <div class="bn-track" style={`--i:${Math.max(activeIndex, 0)}`} data-has-active={activeIndex >= 0 ? 'true' : 'false'}>
    <span class="bn-pill" aria-hidden="true"></span>
    <ul class="bn-list">
      {
        nav.map((item) => {
          const cta = item.href === ctaHref;
          return (
            <li>
              <a
                href={href(item.href)}
                data-route={item.href}
                aria-current={isActive(item.href, route) ? 'page' : undefined}
                class:list={['bn-item', { 'bn-cta': cta }]}
              >
                <span class="bn-icon">
                  <Icon name={iconFor[item.href] ?? 'house'} />
                </span>
                <span class="bn-label">{item.short}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<script>
  import { isActive, routeOf } from '../lib/url';

  function sync() {
    const navEl = document.querySelector<HTMLElement>('[data-bottom-nav]');
    if (!navEl) return;
    const track = navEl.querySelector<HTMLElement>('.bn-track');
    const route = routeOf(location.pathname);
    const links = [...navEl.querySelectorAll<HTMLAnchorElement>('a[data-route]')];
    let active = -1;
    links.forEach((a, i) => {
      const on = isActive(a.dataset.route ?? '', route);
      if (on) {
        a.setAttribute('aria-current', 'page');
        active = i;
      } else {
        a.removeAttribute('aria-current');
      }
    });
    if (track) {
      track.dataset.hasActive = active >= 0 ? 'true' : 'false';
      if (active >= 0) track.style.setProperty('--i', String(active));
    }
  }

  document.addEventListener('astro:after-swap', sync);
  document.addEventListener('astro:page-load', sync);
</script>

<style>
  .bottom-nav {
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -8px 24px -18px color-mix(in oklab, var(--color-wine-deep) 45%, transparent);
  }
  .bn-track {
    --pad: 0.25rem;
    position: relative;
    height: 4rem;
    max-width: 36rem;
    margin-inline: auto;
    padding-inline: var(--pad);
  }
  .bn-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    height: 100%;
  }
  /* Píldora activa: 1/5 del ancho útil, se desliza solo con transform. */
  .bn-pill {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: var(--pad);
    width: calc((100% - var(--pad) * 2) / 5);
    border-radius: 0.875rem;
    background: var(--color-card);
    transform: translateX(calc(var(--i, 0) * 100%));
    transition:
      transform 320ms var(--ease-out-expo),
      opacity var(--dur-state) var(--ease-out-quart);
  }
  .bn-track[data-has-active='false'] .bn-pill {
    opacity: 0;
  }
  .bn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    height: 100%;
    min-height: 44px;
    color: var(--color-muted);
    text-decoration: none;
    transition: transform var(--dur-press) var(--ease-out-quart);
  }
  .bn-item:active {
    transform: scale(0.96);
  }
  .bn-item:focus-visible {
    outline-offset: -4px;
    border-radius: 0.875rem;
  }
  .bn-item[aria-current='page'] {
    color: var(--color-wine);
  }
  .bn-item[aria-current='page'] .bn-label {
    font-weight: 600;
  }
  .bn-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 1.75rem;
    border-radius: 999px;
  }
  .bn-label {
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
  }
  /* "Reservar" siempre destacado en vino. */
  .bn-cta {
    color: var(--color-wine);
  }
  .bn-cta .bn-icon {
    background: var(--color-wine);
    color: var(--color-paper);
  }
  .bn-cta .bn-label {
    font-weight: 600;
  }
</style>
