---
// Hueco elegante para fotos reales que aún no existen (doctora, consultorio). Sin stock.
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}
const { label, ratio = '4 / 5', class: className } = Astro.props;
---
<div class:list={['frame', className]}>
  <div class="photo-pending frame-media" style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
    <span class="monogram" aria-hidden="true">A</span>
    <span class="caption" aria-hidden="true">{label}</span>
  </div>
</div>

<style>
  .photo-pending {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 80% at 30% 20%, var(--color-paper), transparent 60%),
      var(--color-card);
  }
  .monogram {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(5rem, 4rem + 6vw, 9rem);
    line-height: 1;
    color: color-mix(in oklab, var(--color-gold) 55%, var(--color-card));
  }
  .caption {
    position: absolute;
    inset-inline: 1rem;
    bottom: 1rem;
    text-align: center;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--color-muted);
  }
</style>
