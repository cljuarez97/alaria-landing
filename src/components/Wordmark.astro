---
// Logotipo oficial: mariposa + letras "Alaria" + "Clínica Estética", vectorizados del arte de la
// clínica (src/assets/brand/). Proporciones del lockup original: el lema mide el 80 % del ancho
// de las letras y va centrado debajo.
import butterfly from '../assets/brand/butterfly.svg?raw';
import letters from '../assets/brand/letters.svg?raw';
import tagline from '../assets/brand/tagline.svg?raw';
import { href } from '../lib/url';
import { site } from '../data/content';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---
<a
  href={href('/')}
  class:list={['wordmark press inline-flex min-h-11 items-center no-underline', tone === 'light' && 'is-light']}
>
  <span class="wm-mark" set:html={butterfly} />
  <span class="wm-type">
    <span class="wm-letters" set:html={letters} />
    <span class="wm-tagline" set:html={tagline} />
  </span>
  <span class="sr-only">{site.name}, inicio</span>
</a>

<style>
  .wordmark {
    --wm-w: 6.5rem;
    gap: 0.75rem;
    color: var(--color-cocoa);
  }
  @media (min-width: 64rem) {
    .wordmark {
      --wm-w: 7.5rem;
    }
  }
  .wm-mark {
    display: block;
    width: calc(var(--wm-w) * 0.42);
  }
  .wm-type {
    display: grid;
    justify-items: center;
    gap: calc(var(--wm-w) * 0.045);
    width: var(--wm-w);
  }
  .wm-letters {
    display: block;
    width: 100%;
  }
  .wm-tagline {
    display: block;
    width: 80%;
  }
  .wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .is-light {
    color: var(--color-paper);
  }
  .is-light .wm-mark {
    color: var(--color-gold);
  }
  .is-light .wm-tagline {
    color: var(--color-mist);
  }
</style>
