---
// Tratamientos con jerarquía: uno destacado + lista editorial numerada (no cards idénticas).
// `transition:name` en imagen y título enlaza con el hero de /tratamientos/[slug]/.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import FramedPicture from './FramedPicture.astro';
import { treatments } from '../data/content';
import { treatmentImage } from '../data/images';
import { focusOf } from '../data/focus';
import { frameCropClass } from '../lib/crop';
import { ui } from '../data/ui';
import { href } from '../lib/url';

interface Props {
  /** Nivel de los títulos de cada tratamiento. */
  level?: 2 | 3;
  /** Solo cuando el destacado queda arriba del pliegue (índice de tratamientos): es el LCP. */
  priority?: boolean;
}
const { level = 3, priority = false } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const [featured, ...rest] = treatments;
const featuredImg = featured ? treatmentImage(featured.slug) : undefined;
---
<div class="showcase grid gap-14 lg:grid-cols-12 lg:gap-x-12">
  {
    featured && (
      <article class="featured lg:col-span-7" data-reveal={priority ? undefined : ""}>
        <a href={href(`/tratamientos/${featured.slug}/`)} class="group block no-underline">
          <div class="featured-media relative">
          <FramedPicture
            src={featuredImg!}
            alt=""
            widths={[480, 720, 960, 1280]}
            class={frameCropClass(featuredImg!)}
            position={focusOf(featured.slug)}
            sizes="(min-width: 1024px) 40rem, calc(100vw - 2.5rem - 8px)"
            transitionName={`tx-img-${featured.slug}`}
            mediaClass="zoom"
            priority={priority}
          />
          <span class="featured-cta" aria-hidden="true">
            <Icon name="arrow-right" />
          </span>
          </div>
          <div class="mt-8 flex items-start gap-5">
            <span class="numeral text-[clamp(3rem,2.4rem+2.4vw,4.5rem)]" data-n={featured.number} aria-hidden="true"></span>
            <div class="pt-1">
              <H class="t-h2 text-charcoal group-hover:text-wine">
                <span class="block" transition:name={`tx-title-${featured.slug}`}>{featured.name}</span>
              </H>
              <p class="t-body mt-3 text-muted">{featured.short}</p>
              <span class="link mt-3">
                {ui.readMore}
                <Icon name="arrow-right" class="icon-forward" />
              </span>
            </div>
          </div>
        </a>
      </article>
    )
  }

  <ol class="lg:col-span-5 lg:pt-2" role="list">
    {
      rest.map((t, i) => (
        <li class="row border-t border-line last:border-b" data-reveal style={`--d:${i + 1}`}>
          <a href={href(`/tratamientos/${t.slug}/`)} class="row-link press group grid grid-cols-[auto_1fr_auto] items-start gap-x-4 py-6 no-underline sm:gap-x-6">
            <span class="row-num numeral pt-0.5 text-[2.25rem]" data-n={t.number} aria-hidden="true"></span>
            <div class="min-w-0">
              <H class="t-h3 text-charcoal group-hover:text-wine">
                <span class="block" transition:name={`tx-title-${t.slug}`}>{t.name}</span>
              </H>
              <p class="t-small mt-2 text-muted">{t.short}</p>
            </div>
            <span class="thumb frame-media w-[5.5rem] sm:w-28" style={`--ratio:3/2${focusOf(t.slug) ? `;--focus:${focusOf(t.slug)}` : ''}`} transition:name={`tx-img-${t.slug}`}>
              <Picture
                src={treatmentImage(t.slug)}
                alt=""
                widths={[176, 264]}
                sizes="(min-width: 640px) 7rem, 5.5rem"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
                decoding="async"
              />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .featured :global(.zoom img) {
    transition: transform 700ms var(--ease-out-quart);
  }
  .featured a:hover :global(.zoom img) {
    transform: scale(1.04);
  }
  /* Disco vino con flecha sobre la foto destacada: invita al clic sin tapar la imagen. */
  .featured-cta {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: var(--color-wine);
    color: var(--color-paper);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-paper) 70%, transparent);
    transition: transform var(--dur-state) var(--ease-out-quart), background-color var(--dur-state) var(--ease-out-quart);
  }
  .featured a:hover .featured-cta {
    transform: translateX(4px);
    background: var(--color-wine-deep);
  }
  .featured a:active .featured-cta {
    transform: scale(0.94);
  }

  /* Filas: un velo rosa crece desde la izquierda al pasar o presionar (solo transform). */
  .row-link {
    position: relative;
    isolation: isolate;
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
  }
  .row-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-rose-soft);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 420ms var(--ease-out-expo);
  }
  .row-link:hover::before,
  .row-link:focus-visible::before,
  .row-link:active::before {
    transform: scaleX(1);
  }
  .row-num {
    transition: transform var(--dur-state) var(--ease-out-quart);
  }
  .row-link:hover .row-num {
    transform: translateX(4px);
  }
  .row a:hover .thumb :global(img) {
    transform: scale(1.06);
  }
  .thumb :global(img) {
    transition: transform 500ms var(--ease-out-quart);
  }
</style>
