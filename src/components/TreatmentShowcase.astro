---
// Tratamientos con jerarquía: uno destacado + lista editorial numerada (no cards idénticas).
// `transition:name` en imagen y título enlaza con el hero de /tratamientos/[slug]/.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import FramedPicture from './FramedPicture.astro';
import { treatments } from '../data/content';
import { treatmentImage } from '../data/images';
import { ui } from '../data/ui';
import { href } from '../lib/url';

interface Props {
  /** Nivel de los títulos de cada tratamiento. */
  level?: 2 | 3;
}
const { level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const [featured, ...rest] = treatments;
---
<div class="showcase grid gap-14 lg:grid-cols-12 lg:gap-x-12">
  {
    featured && (
      <article class="featured lg:col-span-7">
        <a href={href(`/tratamientos/${featured.slug}/`)} class="group block no-underline">
          <FramedPicture
            src={treatmentImage(featured.slug)}
            alt=""
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1024px) 40rem, calc(100vw - 2.5rem - 8px)"
            transitionName={`tx-img-${featured.slug}`}
            mediaClass="zoom"
          />
          <div class="mt-8 flex items-start gap-5">
            <span class="numeral text-[clamp(3rem,2.4rem+2.4vw,4.5rem)]" data-n={featured.number} aria-hidden="true"></span>
            <div class="pt-1">
              <H class="t-h2 text-charcoal group-hover:text-wine">
                <span class="block" transition:name={`tx-title-${featured.slug}`}>{featured.name}</span>
              </H>
              <p class="t-body mt-3 text-muted">{featured.short}</p>
              <span class="link mt-3">
                {ui.readMore}
                <Icon name="arrow-right" class="icon-forward" />
              </span>
            </div>
          </div>
        </a>
      </article>
    )
  }

  <ol class="lg:col-span-5 lg:pt-2" role="list">
    {
      rest.map((t) => (
        <li class="row border-t border-line last:border-b">
          <a href={href(`/tratamientos/${t.slug}/`)} class="press group grid grid-cols-[auto_1fr_auto] items-start gap-x-4 py-6 no-underline sm:gap-x-6">
            <span class="numeral pt-0.5 text-[2.25rem]" data-n={t.number} aria-hidden="true"></span>
            <div class="min-w-0">
              <H class="t-h3 text-charcoal group-hover:text-wine">
                <span class="block" transition:name={`tx-title-${t.slug}`}>{t.name}</span>
              </H>
              <p class="t-small mt-2 text-muted">{t.short}</p>
            </div>
            <span class="thumb frame-media w-[5.5rem] sm:w-28" style="aspect-ratio:3/2" transition:name={`tx-img-${t.slug}`}>
              <Picture
                src={treatmentImage(t.slug)}
                alt=""
                widths={[176, 264]}
                sizes="(min-width: 640px) 7rem, 5.5rem"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
              />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .featured :global(.zoom img) {
    transition: transform 600ms var(--ease-out-quart);
  }
  .featured a:hover :global(.zoom img) {
    transform: scale(1.025);
  }
  .row a:hover .thumb :global(img) {
    transform: scale(1.04);
  }
  .thumb :global(img) {
    transition: transform 400ms var(--ease-out-quart);
  }
</style>
