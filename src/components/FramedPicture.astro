---
// Marco firma: radio 2px + línea fina de oro desplazada 8px.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  /** Proporción CSS, p. ej. "3 / 2". Por defecto la de la imagen. */
  ratio?: string;
  priority?: boolean;
  class?: string;
  mediaClass?: string;
  transitionName?: string;
  /** Punto focal (`object-position`) cuando el marco recorta la imagen. */
  position?: string;
}

const {
  src,
  alt,
  widths,
  sizes,
  ratio = `${src.width} / ${src.height}`,
  priority = false,
  class: className,
  mediaClass,
  transitionName,
  position,
} = Astro.props;
// Variables y no `aspect-ratio` directo: así .frame-tall puede cambiar el recorte por breakpoint.
const mediaStyle = `--ratio:${ratio}${position ? `;--focus:${position}` : ''}`;

const pic = {
  src,
  alt,
  widths,
  sizes,
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  // Con fuente .webp Astro usaría PNG como <img> de respaldo (hasta 1.8 MB): JPG pesa una fracción.
  fallbackFormat: 'jpg' as const,
  loading: priority ? ('eager' as const) : ('lazy' as const),
  fetchpriority: priority ? ('high' as const) : ('auto' as const),
  decoding: priority ? ('sync' as const) : ('async' as const),
};
---
{
  transitionName ? (
    <div class:list={['frame', className]} transition:name={transitionName}>
      <div class:list={['frame-media', mediaClass]} style={mediaStyle}>
        <Picture {...pic} />
      </div>
    </div>
  ) : (
    <div class:list={['frame', className]}>
      <div class:list={['frame-media', mediaClass]} style={mediaStyle}>
        <Picture {...pic} />
      </div>
    </div>
  )
}
