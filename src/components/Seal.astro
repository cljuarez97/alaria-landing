---
// Sello circular: la frase rodea la mariposa del logotipo. Ornamental (aria-hidden):
// la misma frase aparece como texto real en la página. Texto en gold-ink (5.31:1 sobre cream).
import butterfly from '../assets/brand/butterfly.svg?raw';

interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
// Un sello por página: id fijo (build determinista).
const id = 'seal-ring-path';
// La frase da una vuelta completa; textLength la ajusta a la circunferencia (2π·46 ≈ 289).
const ring = `${text.replace(/\.$/, '')} · `;
// La mariposa (1068×964) centrada en el disco interior (r=36).
const mark = butterfly.replace('<svg ', '<svg x="38" y="40" width="44" height="40" class="seal-mono" ');
---
<div class:list={['seal', className]} aria-hidden="true">
  <svg viewBox="0 0 120 120" width="120" height="120">
    <defs>
      <path id={id} d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" />
    </defs>
    <circle cx="60" cy="60" r="59" class="seal-disc" />
    <circle cx="60" cy="60" r="36" class="seal-inner" />
    <g class="seal-ring">
      <text class="seal-text" textLength="289" lengthAdjust="spacingAndGlyphs">
        <textPath href={`#${id}`}>{ring}</textPath>
      </text>
    </g>
    <Fragment set:html={mark} />
  </svg>
</div>

<style>
  .seal {
    width: clamp(6.5rem, 5rem + 5vw, 8.5rem);
    aspect-ratio: 1;
  }
  .seal svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .seal-disc {
    fill: var(--color-cream);
    stroke: var(--color-gold);
    stroke-width: 1;
  }
  .seal-inner {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 0.75;
  }
  .seal-text {
    fill: var(--color-gold-ink);
    font-family: var(--font-sans);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .seal :global(.seal-mono) {
    color: var(--color-cocoa);
  }
</style>
