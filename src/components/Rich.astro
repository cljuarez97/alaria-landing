---
// Pinta un texto de content.ts. Los tramos [pendientes] solo se ven en desarrollo, marcados con
// <mark class="pending">: en producción la paciente nunca lee un dato sin confirmar.
import { splitPending } from '../lib/pending';

interface Props {
  text: string;
}

const segments = splitPending(Astro.props.text);
const isProd = import.meta.env.PROD;
---
{segments.map((s) => (s.pending ? !isProd && <mark class="pending">{s.text}</mark> : s.text))}
