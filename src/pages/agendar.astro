---
import BaseLayout from '../layouts/BaseLayout.astro';
import FramedPicture from '../components/FramedPicture.astro';
import Icon from '../components/Icon.astro';
import { booking, footer, site, treatments } from '../data/content';
import { images } from '../data/images';
import { imageFocus } from '../data/focus';
import { ui } from '../data/ui';
import { href, whatsappUrl } from '../lib/url';
import Ornament from '../components/Ornament.astro';

const f = booking.form;
const p = booking.picker;
const fields = [
  { id: 'name', label: f.name, type: 'text', autocomplete: 'name', required: true },
  { id: 'phone', label: f.phone, type: 'tel', autocomplete: 'tel', required: true, inputmode: 'tel' },
  { id: 'email', label: f.email, type: 'email', autocomplete: 'email', required: false },
] as const;
const weekdays = ['D', 'L', 'M', 'M', 'J', 'V', 'S'];

// Mensajes para el script del cliente (sin duplicar textos en el JS).
const messages = {
  endpoint: booking.endpoint,
  validation: booking.validation,
  submit: f.submit,
  sending: f.sending,
  success: f.success,
  error: f.error,
  slotTaken: f.slotTaken,
  rateLimited: f.rateLimited,
  offline: f.offline,
  loading: p.loading,
  loadError: p.loadError,
  empty: p.empty,
};
---
<BaseLayout title={booking.title} description={booking.intro}>
  <section class="container-x grid gap-x-16 gap-y-12 pt-8 pb-[var(--section)] lg:grid-cols-12 lg:pt-14">
    <div class="lg:col-span-7">
      <Ornament class="hero-in" />
      <h1 class="t-display mt-5">{booking.title}</h1>
      <p class="t-lead hero-in mt-6" style="--d:1">{booking.intro}</p>

      <form
        id="appointment-form"
        class="booking mt-12 grid gap-10"
        novalidate
        data-booking
        data-messages={JSON.stringify(messages)}
      >
        <p id="slot-error" class="field-error slot-error" role="alert" hidden>
          <Icon name="circle-alert" />
          <span data-error-text></span>
        </p>

        <fieldset class="picker" data-picker data-state="loading" aria-describedby="slot-error">
          <legend class="t-h3"><span class="step-n" aria-hidden="true">1</span><span class="sr-only">{p.stepOf.replace('{n}', '1')} </span>{p.dayLegend}</legend>
          <p class="t-small text-muted">{p.timezone}</p>

          <p class="sr-only" data-picker-live role="status"></p>
          <noscript><p class="picker-note t-small text-muted">{p.noScript}</p></noscript>
          <div class="calendar skeleton mt-5" data-when="loading" aria-hidden="true">
            <div class="calendar-head"><p class="t-small text-muted">{p.loading}</p></div>
            <div class="week t-small text-muted">{weekdays.map((day) => <span>{day}</span>)}</div>
            <div class="days">{Array.from({ length: 35 }, () => <span class="sk-cell"></span>)}</div>
          </div>
          <p class="picker-note t-small text-muted" data-when="empty">{p.empty}</p>
          <div class="picker-note" data-when="error">
            <p class="t-small text-muted">{p.loadError}</p>
            <button type="button" class="btn btn-ghost mt-3" data-retry>
              <Icon name="rotate-ccw" />
              {p.retry}
            </button>
          </div>

          <div class="calendar mt-5" data-when="ready">
            <div class="calendar-head">
              <button type="button" class="month-nav" data-month-prev aria-label={p.prevMonth}>
                <Icon name="arrow-left" />
              </button>
              <p class="font-semibold first-letter:uppercase" data-month-label aria-live="polite"></p>
              <button type="button" class="month-nav" data-month-next aria-label={p.nextMonth}>
                <Icon name="arrow-right" />
              </button>
            </div>
            <div class="week t-small text-muted" aria-hidden="true">
              {weekdays.map((day) => <span>{day}</span>)}
            </div>
            <div class="days" data-days></div>
          </div>
        </fieldset>

        <fieldset class="picker" data-time-set aria-describedby="slot-error" hidden>
          <legend class="t-h3"><span class="step-n" aria-hidden="true">2</span><span class="sr-only">{p.stepOf.replace('{n}', '2')} </span>{p.timeLegend}</legend>
          <div class="times" data-times></div>
        </fieldset>
        <fieldset class="picker grid gap-6" data-details-set>
          <legend class="t-h3"><span class="step-n" aria-hidden="true">3</span><span class="sr-only">{p.stepOf.replace('{n}', '3')} </span>{p.detailsLegend}</legend>
          <p class="summary" data-summary hidden>
            <Icon name="calendar-check" class="text-wine" />
            <span>
              <strong>{p.selected}</strong> <span class="inline-block first-letter:uppercase" data-summary-text></span>
              <span class="t-small block text-muted">{p.pendingNote}</span>
            </span>
          </p>
          {
            fields.map((field) => (
              <div>
                <label for={field.id} class="field-label">
                  {field.label}
                  {field.required && (
                    <span class="text-wine" aria-hidden="true">
                      {' '}
                      *
                    </span>
                  )}
                </label>
                <input
                  id={field.id}
                  name={field.id}
                  type={field.type}
                  autocomplete={field.autocomplete}
                  inputmode={'inputmode' in field ? field.inputmode : undefined}
                  aria-required={field.required ? 'true' : undefined}
                  aria-describedby={field.id === 'email' ? 'email-hint email-error' : `${field.id}-error`}
                  class="field"
                />
                {field.id === 'email' && <p id="email-hint" class="t-small mt-1.5 text-muted">{f.emailHint}</p>}
                <p id={`${field.id}-error`} class="field-error" hidden>
                  <Icon name="circle-alert" />
                  <span data-error-text />
                </p>
              </div>
            ))
          }

          <details class="extras details-reveal" data-extras>
            <summary class="extras-summary">
              <Icon name="plus" class="extras-icon" />
              {p.extras}
            </summary>
            <div class="details-reveal-body">
              <div class="grid gap-6 pt-5">
              <div>
                <label for="treatment" class="field-label">{f.treatment}</label>
                <select id="treatment" name="treatment" class="field">
                  <option value="">{ui.selectPlaceholder}</option>
                  <option value={ui.generalAssessment}>{ui.generalAssessment}</option>
                  {treatments.map((t) => <option value={t.name} data-slug={t.slug}>{t.name}</option>)}
                </select>
              </div>

              <div>
                <label for="message" class="field-label">{f.message}</label>
                <textarea id="message" name="message" rows="4" class="field"></textarea>
              </div>
              </div>
            </div>
          </details>
        </fieldset>

        <!-- Honeypot: invisible y fuera del orden de tabulación. -->
        <div class="honeypot" aria-hidden="true">
          <label for="botcheck">No llenar</label>
          <input id="botcheck" name="botcheck" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-4">
          <button type="submit" class="btn btn-primary submit w-full sm:w-fit" data-state="idle">
            <span class="submit-icon" aria-hidden="true">
              <Icon name="loader-circle" class="spin" />
            </span>
            <span data-submit-label>{f.submit}</span>
          </button>
          <p class="t-small text-muted">
            {f.privacy} <a href={href('/privacidad/')} class="underline underline-offset-4">{footer.privacyLink}</a>
          </p>
        </div>

        <a href={whatsappUrl(site.whatsapp, site.whatsappMessage)} target="_blank" rel="noopener" class="link w-fit">
          <Icon name="message-circle" />
          {booking.whatsappAlt}
          <span class="sr-only">{ui.newTab}</span>
        </a>
        <div role="status" aria-live="polite" class="status" data-status data-kind="none">
          <span class="status-icon" aria-hidden="true">
            <span data-icon="success"><Icon name="check" /></span>
            <span data-icon="error"><Icon name="circle-alert" /></span>
            <span data-icon="offline"><Icon name="wifi-off" /></span>
          </span>
          <span data-status-text></span>
        </div>
      </form>
    </div>

    <aside class="hidden lg:col-span-5 lg:block">
      <div class="lg:sticky lg:top-10">
        <FramedPicture
          src={images['visitanos-consultorio']}
          alt={ui.clinicPhotoAlt}
          widths={[450, 600, 900]}
          sizes="27.75rem"
          ratio="4 / 5"
          position={imageFocus['visitanos-consultorio']}
        />
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  import '../scripts/booking-page';
</script>

<style>
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: 0.625rem;
    border-radius: 999px;
    background: var(--color-wine);
    color: var(--color-paper);
    font-family: var(--font-sans, inherit);
    font-size: 0.9375rem;
    font-weight: 600;
    vertical-align: 0.15em;
  }
  [data-time-set],
  [data-details-set] {
    scroll-margin-top: 1rem;
  }
  /* Mismas medidas que el calendario real: al llegar los horarios la página no salta. */
  .skeleton .calendar-head {
    justify-content: center;
    min-height: 2.75rem;
  }
  .picker .days > span {
    aspect-ratio: 1;
  }
  .sk-cell {
    border-radius: 2px;
    background: var(--color-card);
    animation: sk-pulse 1.4s ease-in-out infinite alternate;
  }
  @keyframes sk-pulse {
    to {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-cell {
      animation: none;
    }
  }
  .extras-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--color-wine);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .extras-summary::-webkit-details-marker {
    display: none;
  }
  .extras-summary :global(.extras-icon) {
    transition: transform var(--dur-state) var(--ease-out-quart);
  }
  .extras[open] .extras-summary :global(.extras-icon) {
    transform: rotate(45deg);
  }
  .picker {
    min-width: 0;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .picker legend {
    padding: 0;
    margin-bottom: 0.75rem;
  }
  /* Solo se ve el bloque del estado actual: cargando, listo, sin horas o error. */
  .picker [data-when] {
    display: none;
  }
  .picker[data-state='loading'] [data-when='loading'],
  .picker[data-state='empty'] [data-when='empty'],
  .picker[data-state='error'] [data-when='error'],
  .picker[data-state='ready'] [data-when='ready'] {
    display: block;
  }
  /* Sin JavaScript nunca termina de cargar: se muestra el aviso de <noscript>. */
  :global(html:not(.js)) .picker [data-when='loading'] {
    display: none;
  }
  .slot-error {
    scroll-margin-top: 1rem;
  }
  .picker-note {
    margin-top: 1.25rem;
  }
  .calendar {
    max-width: 26rem;
  }
  .calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .month-nav {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-wine);
    cursor: pointer;
  }
  .month-nav:disabled {
    color: var(--color-line);
    cursor: default;
  }
  .week,
  .days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.25rem;
    text-align: center;
  }
  .week {
    margin-bottom: 0.25rem;
  }
  .times {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.5rem;
  }
  /* Radios nativos (teclado y lector de pantalla gratis) con apariencia de botón. */
  .picker :global(.day),
  .picker :global(.slot) {
    position: relative;
    display: block;
  }
  .picker :global(.day input),
  .picker :global(.slot input) {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .picker :global(.day input:disabled) {
    cursor: default;
  }
  .picker :global(.day span),
  .picker :global(.slot span) {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    border-radius: 2px;
    transition:
      background-color 160ms,
      color 160ms;
  }
  .picker :global(.day span) {
    aspect-ratio: 1;
    height: 100%;
    min-height: 0;
    background: var(--color-card);
    font-weight: 600;
  }
  .picker :global(.slot span) {
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 0.9375rem;
  }
  .picker :global(.day input:disabled + span) {
    background: none;
    color: var(--color-muted);
    font-weight: 400;
    opacity: 0.55;
  }
  .picker :global(.day input:not(:disabled):hover + span),
  .picker :global(.slot input:hover + span) {
    box-shadow: inset 0 0 0 1px var(--color-wine);
  }
  .picker :global(.day input:checked + span),
  .picker :global(.slot input:checked + span) {
    background: var(--color-wine);
    color: var(--color-paper);
  }
  .picker :global(.day input:focus-visible + span),
  .picker :global(.slot input:focus-visible + span) {
    outline: 2px solid var(--color-wine);
    outline-offset: 2px;
  }
  .summary {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    padding: 1rem 1.125rem;
    border-radius: 2px;
    background: var(--color-card);
  }
  .summary[hidden] {
    display: none;
  }
  .summary :global(.icon) {
    margin-top: 0.15em;
    flex-shrink: 0;
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    position: relative;
  }
  .submit-icon {
    display: none;
  }
  .submit[data-state='sending'] .submit-icon {
    display: inline-grid;
  }
  .submit :global(.spin) {
    animation: spin 900ms linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .status {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    padding: 1rem 1.125rem;
    border-radius: 2px;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-line);
    line-height: 1.5;
  }
  .status[data-kind='none'] {
    /* Vacío pero presente en el DOM para que aria-live funcione. */
    padding: 0;
    box-shadow: none;
    background: none;
  }
  .status-icon > span {
    display: none;
  }
  .status-icon :global(.icon) {
    margin-top: 0.15em;
  }
  .status[data-kind='success'] {
    color: var(--color-success);
    animation: rise 280ms var(--ease-out-quart);
  }
  .status[data-kind='success'] [data-icon='success'],
  .status[data-kind='error'] [data-icon='error'],
  .status[data-kind='offline'] [data-icon='offline'] {
    display: inline-flex;
  }
  .status[data-kind='error'],
  .status[data-kind='offline'] {
    color: var(--color-danger);
    animation: rise 280ms var(--ease-out-quart);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
