---
import BaseLayout from '../layouts/BaseLayout.astro';
import FramedPicture from '../components/FramedPicture.astro';
import Rich from '../components/Rich.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Ornament from '../components/Ornament.astro';
import { booking, home, site, visit } from '../data/content';
import { images } from '../data/images';
import { imageFocus } from '../data/focus';
import { ui } from '../data/ui';
import { mapsUrl, whatsappUrl } from '../lib/url';

const telHref = `tel:${visit.phone.replace(/[^\d+]/g, '')}`;
const maps = mapsUrl(visit.mapsQuery);
---
<BaseLayout title={visit.seoTitle} description={visit.metaDescription} pageType="ContactPage" crumbs={[{ name: visit.title, path: '/visitanos/' }]}>
  <section class="container-x pt-8 pb-[var(--section)] lg:pt-14">
    <header class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <Ornament class="hero-in" />
        <h1 class="t-display mt-5">{visit.title}</h1>
      </div>
      <p class="t-lead hero-in lg:col-span-6 lg:pb-2" style="--d:1">{visit.intro}</p>
    </header>

    <div class="mt-12 grid gap-14 lg:mt-16 lg:grid-cols-12">
      <div class="visit-card surface-rose on-rose grid content-start gap-10 p-6 sm:p-10 lg:col-span-5" data-reveal>
        <div>
          <h2 class="t-eyebrow">{ui.address}</h2>
          <address class="mt-3 font-serif text-2xl leading-snug not-italic">
            {visit.address.map((line) => <span class="block">{line}</span>)}
          </address>
          <a href={maps} target="_blank" rel="noopener" class="btn btn-primary mt-5 w-full sm:w-fit">
            <Icon name="map-pin" />
            {booking.confirmation.directions}
            <span class="sr-only">{ui.newTab}</span>
          </a>
        </div>

        <div>
          <h2 class="t-eyebrow">{ui.hours}</h2>
          <dl class="mt-4 border-t border-rose-deep/40">
            {
              visit.hours.map((h) => (
                <div class="grid gap-1 border-b border-rose-deep/40 py-4 sm:flex sm:items-baseline sm:justify-between sm:gap-6">
                  <dt class="font-semibold">{h.day}</dt>
                  <dd class="flex items-center gap-2 sm:text-right">
                    <Icon name="clock" class="text-gold-ink" />
                    <Rich text={h.time} />
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="grid gap-4">
          <p class="t-body text-muted">{visit.contactNote}</p>
          <ul class="grid gap-1">
            <li>
              <a href={telHref} class="link">
                <Icon name="phone" />
                {visit.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${visit.email}`} class="link break-all">
                <Icon name="mail" />
                {visit.email}
              </a>
            </li>
          </ul>
          <div class="flex flex-wrap gap-3">
            <a href={whatsappUrl(site.whatsapp, site.whatsappMessage)} target="_blank" rel="noopener" class="btn btn-ghost w-fit">
              <Icon name="whatsapp" />
              {home.ctaSecondary}
              <span class="sr-only">{ui.newTab}</span>
            </a>
            <a href={site.instagram} target="_blank" rel="noopener" class="btn btn-ghost w-fit">
              <Icon name="instagram" />
              {site.instagramHandle}
              <span class="sr-only">{ui.instagram} {ui.newTab}</span>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal style="--d:1">
        <FramedPicture
          src={images['visitanos-consultorio']}
          alt={ui.clinicPhotoAlt}
          widths={[480, 720, 900]}
          sizes="(min-width: 1232px) 40rem, (min-width: 1024px) 56vw, calc(100vw - 2.5rem - 8px)"
          class="frame-tall"
          position={imageFocus['visitanos-consultorio']}
        />
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
