---
import BaseLayout from '../layouts/BaseLayout.astro';
import FramedPicture from '../components/FramedPicture.astro';
import PhotoPending from '../components/PhotoPending.astro';
import Rich from '../components/Rich.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Ornament from '../components/Ornament.astro';
import { home, site, visit } from '../data/content';
import { images } from '../data/images';
import { ui } from '../data/ui';
import { isPending } from '../lib/pending';
import { whatsappUrl } from '../lib/url';

// El enlace a Google Maps solo aparece cuando hay dirección real.
const mapsUrl = isPending(visit.mapsQuery)
  ? null
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(visit.mapsQuery)}`;
---
<BaseLayout title={visit.title} description={`${visit.intro} ${site.name}.`}>
  <section class="container-x pt-8 pb-[var(--section)] lg:pt-14">
    <header class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <Ornament class="hero-in" />
        <h1 class="t-display mt-5">{visit.title}</h1>
      </div>
      <p class="t-lead hero-in lg:col-span-6 lg:pb-2" style="--d:1">{visit.intro}</p>
    </header>

    <FramedPicture
      src={images['visitanos-entrada']}
      alt=""
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1232px) 72rem, calc(100vw - 2.5rem - 8px)"
      priority
      class="mt-12 lg:mt-16"
    />

    <div class="mt-16 grid gap-14 lg:mt-24 lg:grid-cols-12">
      <div class="visit-card surface-rose on-rose grid content-start gap-10 p-6 sm:p-10 lg:col-span-5" data-reveal>
        <div>
          <h2 class="t-eyebrow">{ui.address}</h2>
          <p class="mt-3 font-serif text-2xl leading-snug"><Rich text={visit.address} /></p>
          {
            mapsUrl && (
              <a href={mapsUrl} target="_blank" rel="noopener" class="link mt-2">
                <Icon name="map-pin" />
                Google Maps
                <span class="sr-only">{ui.newTab}</span>
              </a>
            )
          }
        </div>

        <div>
          <h2 class="t-eyebrow">{ui.hours}</h2>
          <dl class="mt-4 border-t border-rose-deep/40">
            {
              visit.hours.map((h) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-rose-deep/40 py-4">
                  <dt class="font-semibold">{h.day}</dt>
                  <dd class="flex items-center gap-2 text-right">
                    <Icon name="clock" class="text-gold-ink" />
                    <Rich text={h.time} />
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="grid gap-4">
          <p class="t-body text-muted"><Rich text={visit.contactNote} /></p>
          <a href={whatsappUrl(site.whatsapp, site.whatsappMessage)} target="_blank" rel="noopener" class="btn btn-ghost w-fit">
            <Icon name="message-circle" />
            {home.ctaSecondary}
            <span class="sr-only">{ui.newTab}</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal style="--d:1">
        <PhotoPending label={ui.clinicPhotoPending} ratio="3 / 2" />
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
