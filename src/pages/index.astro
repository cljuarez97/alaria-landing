---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Rich from '../components/Rich.astro';
import FaqList from '../components/FaqList.astro';
import PhotoPending from '../components/PhotoPending.astro';
import TreatmentShowcase from '../components/TreatmentShowcase.astro';
import CtaBand from '../components/CtaBand.astro';
import Ornament from '../components/Ornament.astro';
import Seal from '../components/Seal.astro';
import { faq, home, site, treatments } from '../data/content';
import { images } from '../data/images';
import { ui } from '../data/ui';
import { href, whatsappUrl } from '../lib/url';
import type { IconName } from '../components/icons/icons';
import butterfly from '../assets/brand/butterfly.svg?raw';

// Acento en itálica dentro del h1 sin tocar el texto de content.ts.
const accent = 'medicina estética';
const [h1Before, h1After] = home.h1.includes(accent) ? home.h1.split(accent) : [home.h1, ''];
const hasAccent = home.h1.includes(accent);

// "¿Qué nos hace diferentes?": la última palabra va en itálica, igual que el acento del h1.
const diffAccent = 'diferentes';
const [diffBefore, diffAfter] = home.difference.title.includes(diffAccent)
  ? home.difference.title.split(diffAccent)
  : [home.difference.title, ''];
const diffHasAccent = home.difference.title.includes(diffAccent);
// Un icono por compromiso, en el orden de content.ts (valoración, presupuesto, producto, revisión, cita, dudas).
const diffIcons: IconName[] = ['stethoscope', 'receipt-text', 'shield-check', 'history', 'calendar-clock', 'message-circle'];

const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: site.name,
  description: site.description,
  url: siteUrl,
  logo: new URL('icon-512.png', siteUrl).href,
  image: new URL('icon-512.png', siteUrl).href,
  telephone: `+${site.whatsapp}`,
  areaServed: { '@type': 'Country', name: 'Guatemala' },
  availableService: treatments.map((t) => ({
    '@type': 'MedicalProcedure',
    name: t.name,
    url: new URL(`tratamientos/${t.slug}/`, siteUrl).href,
  })),
};
---
<BaseLayout jsonLd={jsonLd}>
  <!-- Hero: texto a la izquierda, ventana en arco sobre un panel rosa a la derecha. -->
  <section class="hero relative isolate overflow-clip">
    <div class="container-x grid items-center gap-x-12 gap-y-16 pt-6 pb-[var(--section)] lg:grid-cols-12 lg:pt-12">
      <div class="lg:col-span-7">
        <p class="t-eyebrow hero-in" style="--d:0">{home.eyebrow}</p>
        <Ornament class="hero-in mt-4" />
        <h1 class="t-hero mt-5 max-w-[13ch] text-charcoal">
          {
            hasAccent ? (
              <Fragment>
                {h1Before}
                <em class="t-accent text-wine">{accent}</em>
                {h1After}
              </Fragment>
            ) : (
              home.h1
            )
          }
        </h1>
        <p class="t-lead hero-in mt-6 max-w-[38ch] text-charcoal/85" style="--d:1">{home.lead}</p>
        <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" style="--d:2">
          <a href={href('/agendar/')} class="btn btn-primary btn-signature">
            {home.ctaPrimary}
            <Icon name="arrow-right" />
          </a>
          <a href={whatsappUrl(site.whatsapp, site.whatsappMessage)} target="_blank" rel="noopener" class="btn btn-ghost btn-tall">
            <Icon name="message-circle" />
            {home.ctaSecondary}
            <span class="sr-only">{ui.newTab}</span>
          </a>
        </div>
      </div>

      <figure class="hero-figure relative mx-auto w-full max-w-[20rem] sm:max-w-[24rem] lg:col-span-5 lg:max-w-none">
        <span class="hero-backdrop" aria-hidden="true"></span>
        <div class="arch hero-arch-line">
          <div class="arch-media hero-photo" style="aspect-ratio:4/5">
            <Picture
              src={images['hero-arch']}
              alt=""
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 1024px) 28rem, (min-width: 640px) 24rem, 20rem"
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </div>
        </div>
        <Seal text={site.tagline} class="hero-seal" />
        <figcaption class="hero-in mt-10 text-center font-serif text-2xl text-gold-ink italic" style="--d:4">{site.tagline}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Cómo trabajamos: banda rosa, cuatro principios con numeral bajo arco (2×2 en tablet, 4 columnas en escritorio). -->
  <section class="section surface-rose on-rose" aria-labelledby="approach-title">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-6">
          <Ornament reveal />
          <h2 id="approach-title" class="t-h2 mt-5">{home.approach.title}</h2>
        </div>
        <p class="t-body text-wine-deep lg:col-span-6 lg:pb-1">{home.approach.intro}</p>
      </div>
      <ol class="steps mt-14 grid gap-10 md:grid-cols-2 md:gap-x-8 md:gap-y-14 lg:mt-20 lg:grid-cols-4" role="list">
        {
          home.approach.pillars.map((p, i) => (
            <li class="step" data-reveal style={`--d:${i}`}>
              <span class="arch-numeral" aria-hidden="true">
                <span class="numeral text-[2.5rem]" data-n={String(i + 1).padStart(2, '0')}></span>
              </span>
              <h3 class="t-h3 mt-6">{p.title}</h3>
              <p class="t-body mt-3 text-charcoal">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Qué nos hace diferentes: sobre crema, entre la banda rosa y la sección oscura. Un hilo de oro
       vertical recorre los seis compromisos y termina en la mariposa; en escritorio el CTA queda fijo
       a la izquierda mientras se leen. -->
  <section class="section diff relative isolate overflow-clip" aria-labelledby="diff-title">
    <span class="diff-watermark" aria-hidden="true" set:html={butterfly} />
    <div class="container-x diff-grid">
      <div class="diff-head" data-reveal>
        <Ornament reveal />
        <h2 id="diff-title" class="t-h2 diff-title mt-5">
          {
            diffHasAccent ? (
              <Fragment>
                {diffBefore}
                <em class="t-accent text-wine">{diffAccent}</em>
                {diffAfter}
              </Fragment>
            ) : (
              home.difference.title
            )
          }
        </h2>
        <p class="t-lead mt-6 text-charcoal/85">{home.difference.intro}</p>
      </div>

      <div class="diff-track">
        <span class="diff-thread" aria-hidden="true" data-reveal="fade"></span>
        <ol class="diff-list" role="list">
          {
            home.difference.items.map((item, i) => (
              <li class="diff-item" data-reveal style={`--d:${i % 3}`}>
                <span class="diff-icon">
                  <Icon name={diffIcons[i] ?? 'check'} />
                </span>
                <div class="diff-copy">
                  <h3 class="diff-item-title">{item.title}</h3>
                  <p class="t-body text-muted">
                    <Rich text={item.text} />
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        <span class="diff-end" aria-hidden="true" data-reveal="fade" set:html={butterfly} />
      </div>

      <div class="diff-cta" data-reveal style="--d:1">
        <a href={href('/agendar/')} class="btn btn-primary btn-signature w-full sm:w-fit">
          {home.difference.cta}
          <Icon name="calendar-check" />
        </a>
        <a href={whatsappUrl(site.whatsapp, site.whatsappMessage)} target="_blank" rel="noopener" class="link">
          <Icon name="message-circle" />
          {home.ctaSecondary}
          <span class="sr-only">{ui.newTab}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Equipo médico: la sección oscura del ritmo, en wine-deep con oro. -->
  <section id="equipo" class="section doctor surface-dark on-dark relative isolate overflow-clip" aria-labelledby="doctor-title">
    <div class="container-x grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="mx-auto w-full max-w-[22rem] lg:col-span-5 lg:max-w-none" data-reveal>
        <PhotoPending label={ui.doctorPhotoPending} />
      </div>
      <div class="lg:col-span-7 lg:pt-6" data-reveal style="--d:1">
        <p class="t-eyebrow">{site.doctor.title}</p>
        <Ornament class="mt-4" />
        <h2 id="doctor-title" class="t-h2 mt-5">{home.doctorTeaser.title}</h2>
        <p class="t-lead mt-6 text-cream"><Rich text={home.doctorTeaser.text} /></p>

        <details class="more details-reveal mt-8">
          <summary class="link">
            {home.doctorTeaser.cta}
            <Icon name="plus" class="more-icon" />
          </summary>
          <div class="more-body details-reveal-body">
            <div class="grid gap-4 pt-4 text-cream">
              {
                site.doctor.bioLong.map((para) => (
                  <p class="t-body">
                    <Rich text={para} />
                  </p>
                ))
              }
              <h3 class="t-h3 mt-6 text-paper">{ui.credentials}</h3>
              <ul class="grid gap-2" role="list">
                {
                  site.doctor.credentials.map((c) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.7em] h-px w-4 flex-none bg-gold" aria-hidden="true" />
                      <span>
                        <Rich text={c} />
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </details>

        <a href={href('/agendar/')} class="btn btn-light btn-signature mt-10 w-full sm:w-fit">
          {home.ctaPrimary}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <!-- Tratamientos -->
  <section class="section" aria-labelledby="treatments-title">
    <div class="container-x">
      <div class="mb-14 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div>
          <Ornament reveal />
          <h2 id="treatments-title" class="t-h2 mt-5">{home.treatmentsTeaser.title}</h2>
          <p class="t-body mt-4 text-muted">{home.treatmentsTeaser.intro}</p>
        </div>
        <a href={href('/tratamientos/')} class="link">
          {home.ctaTertiary}
          <Icon name="arrow-right" class="icon-forward" />
        </a>
      </div>
      <TreatmentShowcase level={3} />
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section surface-rose on-rose" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <Ornament reveal />
        <h2 id="faq-title" class="t-h2 mt-5">{home.faqTeaser.title}</h2>
      </div>
      <div class="lg:col-span-8" data-reveal style="--d:1">
        <FaqList items={faq} />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* Panel rosa que sangra hasta el borde derecho: da color al hero sin tapar el texto. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0 0;
    height: 38%;
    background: var(--color-rose-soft);
  }
  @media (min-width: 64rem) {
    .hero::before {
      inset: 2.5rem 0 0 auto;
      width: 36%;
      height: auto;
      border-top-left-radius: 14rem;
    }
  }
  .t-hero {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.75rem, 1.9rem + 4.2vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-optical-sizing: auto;
  }
  .btn-tall {
    min-height: 3.5rem;
  }
  /* Arco rosa desplazado detrás de la foto: profundidad sin sombras genéricas. */
  .hero-backdrop {
    position: absolute;
    z-index: -1;
    inset: 12% -10% 18% 14%;
    border-radius: 999px 999px 2px 2px;
    background: var(--color-rose);
  }
  .hero-figure :global(.hero-seal) {
    position: absolute;
    left: -1.25rem;
    top: 62%;
  }
  @media (min-width: 64rem) {
    /* Entre 1024 y 1280px el lead llega casi al borde de su columna: el sello entra menos en el gap. */
    .hero-figure :global(.hero-seal) {
      left: -1.25rem;
    }
  }
  @media (min-width: 80rem) {
    /* No más que el gap de columnas (3rem). */
    .hero-figure :global(.hero-seal) {
      left: -2.25rem;
    }
  }

  /* Pasos: en tablet/escritorio un hilo de oro une cada arco con el siguiente de su fila
     (2×2 en tablet: solo los impares; 4 columnas: todos menos el último). Se dibuja al aparecer. */
  .step {
    position: relative;
  }
  @media (min-width: 48rem) {
    .step::after {
      content: '';
      position: absolute;
      left: 4.5rem;
      right: -2rem; /* = md:gap-x-8 */
      top: 2.5rem;
      height: 1px;
      background: color-mix(in oklab, var(--color-gold) 70%, transparent);
      transform-origin: left center;
    }
    .step:nth-child(2n)::after {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .step:nth-child(2n)::after {
      display: block;
    }
    .step:last-child::after {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .step[data-reveal]::after {
      transform: scaleX(0);
      transition: transform 1100ms var(--ease-out-expo) calc(var(--d, 0) * 90ms + 250ms);
    }
    :global(.js) .step[data-reveal]:global(.is-in)::after {
      transform: none;
    }
  }
  .step .arch-numeral {
    background: var(--color-rose-soft);
  }
  /* El oro sobre rosa da 1.6:1; gold-ink (4.41:1 a 40px) sí se lee. */
  .step .numeral {
    color: var(--color-gold-ink);
  }

  /* Arco de oro en la esquina de la sección oscura, eco del hero. */
  .doctor::before {
    display: none;
    content: '';
    position: absolute;
    z-index: -1;
    left: -8rem;
    bottom: -10rem;
    width: 26rem;
    height: 34rem;
    border: 1px solid color-mix(in oklab, var(--color-gold) 45%, transparent);
    border-radius: 999px 999px 0 0;
    pointer-events: none;
  }
  /* En móvil el arco cruzaría el texto: solo a partir de escritorio. */
  @media (min-width: 64rem) {
    .doctor::before {
      display: block;
    }
  }

  .more summary {
    list-style: none;
    cursor: pointer;
    width: fit-content;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more :global(.more-icon) {
    transition: transform var(--dur-state) var(--ease-out-quart);
  }
  .more[open] :global(.more-icon) {
    transform: rotate(45deg);
  }
  /* ---------- ¿Qué nos hace diferentes? ---------- */
  .diff-title {
    font-size: clamp(2.375rem, 1.7rem + 3vw, 4rem);
    line-height: 1.02;
    max-width: 12ch;
  }
  .diff-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64rem) {
    /* Orden del DOM: cabecera, lista, CTA (así se lee y se tabula en móvil).
       En escritorio el CTA sube a la columna izquierda y queda fijo mientras se recorre la lista. */
    .diff-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'head track'
        'cta track';
      column-gap: clamp(3rem, 1rem + 4vw, 6rem);
      row-gap: 2.5rem;
    }
    .diff-head {
      grid-area: head;
    }
    .diff-track {
      grid-area: track;
    }
    .diff-cta {
      grid-area: cta;
      align-self: start;
      position: sticky;
      top: 2rem;
    }
  }
  .diff-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  @media (min-width: 40rem) and (max-width: 63.999rem) {
    .diff-cta {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }

  /* Lista: icono en disco de papel sobre el hilo de oro, texto a la derecha.
     El filete separador va bajo el texto, no bajo el icono, para no cruzar el hilo. */
  .diff-track {
    --disc: 2.75rem;
    position: relative;
  }
  .diff-thread {
    position: absolute;
    left: calc(var(--disc) / 2);
    top: calc(var(--disc) / 2);
    bottom: 1rem;
    width: 1px;
    background: var(--color-gold);
    transform-origin: top center;
  }
  .diff-item {
    display: grid;
    grid-template-columns: var(--disc) minmax(0, 1fr);
    column-gap: 1.25rem;
  }
  .diff-item + .diff-item {
    margin-top: 1.25rem;
  }
  .diff-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--disc);
    height: var(--disc);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-wine);
    box-shadow: inset 0 0 0 1px var(--color-gold);
  }
  .diff-copy {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.45rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 48rem) {
    .diff-item + .diff-item {
      margin-top: 1.75rem;
    }
    .diff-copy {
      padding-bottom: 1.75rem;
    }
  }
  .diff-item-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-charcoal);
    text-wrap: balance;
  }
  /* Tablet y escritorio ancho: título y texto en dos columnas, como un índice editorial. */
  @media (min-width: 48rem) and (max-width: 63.999rem), (min-width: 80rem) {
    .diff-copy {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      column-gap: 2rem;
      align-items: baseline;
    }
  }
  /* La mariposa cierra el hilo: el recorrido termina en ti. */
  .diff-end {
    display: block;
    width: var(--disc);
    margin-top: 1.25rem;
    color: var(--color-gold);
  }
  .diff-end :global(svg) {
    display: block;
    width: 1.75rem;
    height: auto;
    margin-inline: auto;
  }
  /* Marca de agua: la mariposa grande en rosa detrás de la cabecera, solo donde no cruza el texto. */
  .diff-watermark {
    display: none;
  }
  @media (min-width: 64rem) {
    .diff-watermark {
      display: block;
      position: absolute;
      z-index: -1;
      left: max(-6rem, calc(50% - 46rem));
      bottom: -4rem;
      width: clamp(20rem, 12rem + 14vw, 30rem);
      color: var(--color-rose-soft);
      transform: rotate(-10deg);
      pointer-events: none;
    }
    .diff-watermark :global(svg) {
      display: block;
      width: 100%;
      height: auto;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* El hilo crece de arriba abajo al entrar la lista; los items aparecen escalonados encima. */
    :global(.js) .diff-thread[data-reveal] {
      opacity: 1;
      transform: scaleY(0);
      transition: transform 1800ms var(--ease-out-expo) 150ms;
    }
    :global(.js) .diff-thread[data-reveal]:global(.is-in) {
      transform: none;
    }
    :global(.js) .diff-end[data-reveal] {
      transform: scale(0.6);
      transition:
        opacity 600ms var(--ease-out-quart) 500ms,
        transform 900ms var(--ease-out-expo) 500ms;
    }
    :global(.js) .diff-end[data-reveal]:global(.is-in) {
      transform: none;
    }
  }
</style>
