---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { home, site } from '../data/content';
import { ui } from '../data/ui';
import { whatsappUrl } from '../lib/url';
---
<BaseLayout title={ui.offline.title} description={ui.offline.text} noindex>
  <section class="container-x grid min-h-[60dvh] content-center gap-6 py-[var(--section)]">
    <span class="numeral text-[5rem]" data-n={"—"} aria-hidden="true"></span>
    <h1 class="t-display max-w-[14ch]">{ui.offline.title}</h1>
    <p class="t-lead">{ui.offline.text}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-primary" onclick="location.reload()">
        <Icon name="rotate-ccw" />
        {ui.offline.retry}
      </button>
      <a href={whatsappUrl(site.whatsapp, site.whatsappMessage)} target="_blank" rel="noopener" class="btn btn-ghost">
        <Icon name="message-circle" />
        {home.ctaSecondary}
        <span class="sr-only">{ui.newTab}</span>
      </a>
    </div>
  </section>
</BaseLayout>
