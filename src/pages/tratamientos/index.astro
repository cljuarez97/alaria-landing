---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TreatmentShowcase from '../../components/TreatmentShowcase.astro';
import CtaBand from '../../components/CtaBand.astro';
import Ornament from '../../components/Ornament.astro';
import { home } from '../../data/content';
import { treatmentListNode } from '../../lib/schema';

---
<BaseLayout
  title={home.treatmentsTeaser.seoTitle}
  description={home.treatmentsTeaser.metaDescription}
  pageType="CollectionPage"
  crumbs={[{ name: home.treatmentsTeaser.title, path: '/tratamientos/' }]}
  schema={({ root, url }) => [treatmentListNode(root, url)]}
>
  <section class="page-head surface-rose on-rose">
    <header class="container-x pt-8 pb-14 lg:pt-14 lg:pb-20">
      <div class="max-w-3xl">
        <p class="t-eyebrow hero-in">{home.eyebrow}</p>
        <Ornament class="hero-in mt-4" />
        <h1 class="t-display mt-5">{home.treatmentsTeaser.title}</h1>
        <p class="t-lead hero-in mt-6" style="--d:1">{home.treatmentsTeaser.intro}</p>
      </div>
    </header>
  </section>
  <section class="container-x pt-14 pb-[var(--section)] lg:pt-20">
    <TreatmentShowcase level={2} priority />
  </section>
  <CtaBand />
</BaseLayout>
