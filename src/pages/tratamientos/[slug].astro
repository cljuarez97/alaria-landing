---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Rich from '../../components/Rich.astro';
import FaqList from '../../components/FaqList.astro';
import FramedPicture from '../../components/FramedPicture.astro';
import CtaBand from '../../components/CtaBand.astro';
import { treatments, type Treatment } from '../../data/content';
import { treatmentImage } from '../../data/images';
import { ui } from '../../data/ui';
import { href } from '../../lib/url';

export const getStaticPaths = (() =>
  treatments.map((treatment, i) => ({
    params: { slug: treatment.slug },
    props: {
      treatment,
      prev: treatments[(i - 1 + treatments.length) % treatments.length]!,
      next: treatments[(i + 1) % treatments.length]!,
    },
  }))) satisfies GetStaticPaths;

interface Props {
  treatment: Treatment;
  prev: Treatment;
  next: Treatment;
}

const { treatment: t, prev, next } = Astro.props;
---
<BaseLayout title={t.name} description={t.metaDescription}>
  <article>
    <!-- Hero del tratamiento -->
    <header class="container-x grid gap-x-12 gap-y-10 pt-6 pb-16 lg:grid-cols-12 lg:items-end lg:pt-10 lg:pb-24">
      <div class="lg:col-span-6 lg:pb-4">
        <a href={href('/tratamientos/')} class="link -ml-0.5 text-[0.9375rem]">
          <Icon name="arrow-left" />
          {ui.backToTreatments}
        </a>
        <span class="numeral mt-8 block text-[clamp(3.5rem,2.8rem+3vw,5.5rem)]" data-n={t.number} aria-hidden="true"></span>
        <h1 class="t-display mt-3">
          <span class="block" transition:name={`tx-title-${t.slug}`}>{t.name}</span>
        </h1>
        <p class="t-lead mt-6">{t.intro}</p>
      </div>
      <FramedPicture
        src={treatmentImage(t.slug)}
        alt=""
        widths={[480, 720, 960, 1100]}
        sizes="(min-width: 1024px) 34rem, calc(100vw - 2.5rem - 8px)"
        priority
        transitionName={`tx-img-${t.slug}`}
        class="lg:col-span-6"
      />
    </header>

    <!-- Datos clave -->
    <div class="border-y border-line bg-paper">
      <dl class="container-x grid divide-line sm:grid-cols-3 sm:divide-x max-sm:divide-y">
        {
          t.facts.map((f) => (
            <div class="py-7 sm:px-8 sm:first:pl-0 sm:last:pr-0">
              <dt class="t-eyebrow">{f.label}</dt>
              <dd class="mt-2">
                <Rich text={f.value} />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Para quién + Qué esperar -->
    <section class="section">
      <div class="container-x grid gap-16 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="forwho-title" class="t-h2">{ui.forWho}</h2>
          <ul class="mt-8 grid gap-4" role="list">
            {
              t.forWho.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-[0.8em] h-px w-5 flex-none bg-gold" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="lg:col-span-7">
          <h2 id="expect-title" class="t-h2">{ui.whatToExpect}</h2>
          <ol class="mt-8" role="list">
            {
              t.whatToExpect.map((s, i) => (
                <li class="grid grid-cols-[3.5rem_1fr] gap-x-4 border-t border-line py-6">
                  <span class="numeral text-[2.25rem]" data-n={String(i + 1).padStart(2, '0')} aria-hidden="true"></span>
                  <div>
                    <h3 class="t-h3">{s.step}</h3>
                    <p class="t-body mt-2">
                      <Rich text={s.text} />
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- Antes de decidir -->
    <section class="bg-card py-[clamp(3rem,2.5rem+3vw,5rem)]" aria-labelledby="before-title">
      <div class="container-x grid gap-8 lg:grid-cols-12">
        <h2 id="before-title" class="t-h2 lg:col-span-5">{ui.beforeDeciding}</h2>
        <ul class="grid gap-4 lg:col-span-7" role="list">
          {
            t.beforeDeciding.map((item) => (
              <li class="flex items-start gap-3 text-[1.0625rem]">
                <Icon name="check" class="mt-[0.2em] text-wine" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Preguntas del tratamiento -->
    <section class="section" aria-labelledby="txfaq-title">
      <div class="container-x grid gap-10 lg:grid-cols-12">
        <h2 id="txfaq-title" class="t-h2 lg:col-span-4">{ui.treatmentFaq}</h2>
        <div class="lg:col-span-8">
          <FaqList items={t.faq} />
        </div>
      </div>
    </section>

    <!-- Anterior / siguiente -->
    <nav class="container-x pb-[var(--section)]" aria-label={ui.backToTreatments}>
      <ul class="grid gap-3 border-t border-line pt-8 sm:grid-cols-2" role="list">
        <li>
          <a href={href(`/tratamientos/${prev.slug}/`)} class="press group flex min-h-11 flex-col gap-1 no-underline">
            <span class="t-small inline-flex items-center gap-1.5 text-muted">
              <Icon name="arrow-left" />
              {ui.prevTreatment}
            </span>
            <span class="font-serif text-2xl text-charcoal group-hover:text-wine">{prev.name}</span>
          </a>
        </li>
        <li class="sm:text-right">
          <a href={href(`/tratamientos/${next.slug}/`)} class="press group flex min-h-11 flex-col gap-1 no-underline sm:items-end">
            <span class="t-small inline-flex items-center gap-1.5 text-muted">
              {ui.nextTreatment}
              <Icon name="arrow-right" />
            </span>
            <span class="font-serif text-2xl text-charcoal group-hover:text-wine">{next.name}</span>
          </a>
        </li>
      </ul>
    </nav>
  </article>
  <CtaBand />
</BaseLayout>
