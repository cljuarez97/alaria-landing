---
// Sin casos reales con consentimiento: la página sale del menú y de Google para no prometer lo que aún
// no se puede mostrar. Al tener casos, usa `BeforeAfter` aquí, quita `noindex` y devuélvela a `nav`.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Ornament from '../components/Ornament.astro';
import { home, results } from '../data/content';
import { href } from '../lib/url';
---
<BaseLayout title={results.title} description={results.intro} noindex>
  <section class="container-x section pt-8 lg:pt-14">
    <Ornament class="hero-in" />
    <h1 class="t-display mt-5">{results.title}</h1>
    <p class="t-lead hero-in mt-6" style="--d:1">{results.intro}</p>
    <div class="mt-10 grid max-w-[48rem] gap-5">
      <p class="font-serif text-2xl leading-snug text-wine italic">{results.beforeAfter.emptyState}</p>
      <p class="t-small text-muted">{results.beforeAfter.consentNote}</p>
      <a href={href('/agendar/')} class="link w-fit">
        {home.ctaPrimary}
        <Icon name="arrow-right" class="icon-forward" />
      </a>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
