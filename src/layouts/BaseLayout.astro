---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import playfairNormal from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import playfairItalic from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-italic.woff2?url';
import jakartaNormal from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import PwaHead from '../components/PwaHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BottomNav from '../components/BottomNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { images } from '../data/images';
import { site } from '../data/content';
import { ui } from '../data/ui';
import { pageTransition } from '../lib/transitions';

interface Props {
  /** Título de la página; se completa con el nombre de la clínica. */
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, noindex = false, jsonLd } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: images['splash-ventana'], width: 1200, height: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Solo subset latin (cubre español). Rango igual al de fontsource.
const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Playfair Display Variable';font-style:normal;font-display:swap;font-weight:400 900;src:url(${playfairNormal}) format('woff2-variations');unicode-range:${latin}}
@font-face{font-family:'Playfair Display Variable';font-style:italic;font-display:swap;font-weight:400 900;src:url(${playfairItalic}) format('woff2-variations');unicode-range:${latin}}
@font-face{font-family:'Plus Jakarta Sans Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${jakartaNormal}) format('woff2-variations');unicode-range:${latin}}`;
---
<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Solo la fuente del h1 (LCP móvil); la itálica es acento y carga con swap. -->
    <link rel="preload" href={playfairNormal} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <PwaHead />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_GT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed left-4 top-4 z-50 rounded-[2px] bg-wine px-4 py-3 font-semibold text-paper"
      >{ui.skipLink}</a
    >
    <SiteHeader />
    <main id="main" tabindex="-1" transition:animate={pageTransition}>
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppFab />
    <BottomNav />

    <script>
      // Tras cada navegación del ClientRouter: foco al h1 (o al main). El anuncio de ruta lo hace
      // la región aria-live que inyecta Astro (.astro-route-announcer) con el <title> nuevo.
      let firstLoad = true;
      document.addEventListener('astro:page-load', () => {
        if (firstLoad) {
          firstLoad = false;
          return;
        }
        if (location.hash) return;
        const target = document.querySelector<HTMLElement>('main h1') ?? document.getElementById('main');
        if (!target) return;
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
